{{ 'laville.css' | asset_url | stylesheet_tag }}

<section class="lv-social">
  <div class="lv-container lv-social__grid">
    <div data-reveal="fade-left" class="lv-social__stat-card">
      <p class="lv-eyebrow">{{ section.settings.eyebrow }}</p>
      <p class="lv-head lv-social__stat">{{ section.settings.stat }}</p>
      <p class="lv-social__stat-text">{{ section.settings.stat_text }}</p>
    </div>
    <div data-reveal="fade-right" style="--reveal-delay: 120ms" class="lv-social__quote-card">
      <p class="lv-social__quote-label">{{ section.settings.quote_label }}</p>
      <blockquote class="lv-social__quote">
        {{ section.settings.quote }}
      </blockquote>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LV Social Proof",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Local shop history" },
    { "type": "text", "id": "stat", "label": "Stat", "default": "3rd" },
    { "type": "textarea", "id": "stat_text", "label": "Stat text", "default": "generation of barber suppliers in the Potoczky family." },
    { "type": "text", "id": "quote_label", "label": "Quote label", "default": "From the counter" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "“We appreciate our customers for their business and loyalty — and we built this shop to serve working professionals with dependable products.”" }
  ],
  "presets": [{ "name": "LV Social Proof" }]
}
{% endschema %}
