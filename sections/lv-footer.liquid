{{ 'laville.css' | asset_url | stylesheet_tag }}

<footer class="lv-footer">
  <div class="lv-container lv-footer__inner">
    <p>{{ section.settings.copyright }}</p>
    <p>{{ section.settings.note }}</p>
  </div>
</footer>

{%- comment -%} Scroll-reveal observer — runs once on the final section of the page. {%- endcomment -%}
<script>
  (function () {
    var items = document.querySelectorAll('[data-reveal]');
    if (!items.length) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach(function (i) { i.classList.add('is-visible'); });
      return;
    }
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.16 });
    items.forEach(function (i) { obs.observe(i); });
  })();
</script>

{% schema %}
{
  "name": "LV Footer",
  "settings": [
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© LaVille Barber Supply" },
    { "type": "text", "id": "note", "label": "Note", "default": "574-288-7852 · Prices are subject to change." }
  ]
}
{% endschema %}
