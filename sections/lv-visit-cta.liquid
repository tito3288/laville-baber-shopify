{{ 'laville.css' | asset_url | stylesheet_tag }}

<section id="visit" class="lv-container lv-visit">
  <div data-reveal class="lv-visit__card">
    <div class="lv-visit__main">
      <p class="lv-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="lv-head lv-visit__title">{{ section.settings.heading }}</h2>
      <p class="lv-visit__text">{{ section.settings.text }}</p>
      <div class="lv-visit__cta">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="lv-btn lv-btn--accent">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="lv-btn lv-btn--outline">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="lv-visit__details">
      <div class="lv-visit__cell">
        <p class="lv-visit__cell-label">Address</p>
        <p>{{ section.settings.address }}</p>
      </div>
      <div class="lv-visit__cell">
        <p class="lv-visit__cell-label">Phone</p>
        <a href="tel:{{ section.settings.phone | remove: '-' | remove: ' ' }}">{{ section.settings.phone }}</a>
      </div>
      <div class="lv-visit__cell">
        <p class="lv-visit__cell-label">Email</p>
        <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LV Visit CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Visit or call" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Need product help?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Send us a note or visit LaVille Barber Supply at 419 W Ewing Ave. South Bend, IN 46613." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Email LaVille" },
    { "type": "text", "id": "button_link", "label": "Primary button link", "default": "mailto:lavillebarber@gmail.com" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Get Directions" },
    { "type": "text", "id": "button_link_2", "label": "Secondary button link", "default": "https://www.google.com/maps/search/?api=1&query=419+W+Ewing+Ave+South+Bend+IN+46613" },
    { "type": "header", "content": "Contact details" },
    { "type": "html", "id": "address", "label": "Address", "default": "419 W Ewing Ave.<br>South Bend, IN 46613" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "574-288-7852" },
    { "type": "text", "id": "email", "label": "Email", "default": "lavillebarber@gmail.com" }
  ],
  "presets": [{ "name": "LV Visit CTA" }]
}
{% endschema %}
