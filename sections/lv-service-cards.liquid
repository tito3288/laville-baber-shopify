{{ 'laville.css' | asset_url | stylesheet_tag }}

<section id="service" class="lv-container lv-services">
  <div data-reveal class="lv-services__head">
    <p class="lv-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="lv-head lv-services__title">{{ section.settings.heading }}</h2>
  </div>
  <div class="lv-services__grid">
    {%- for block in section.blocks -%}
      <div
        data-reveal
        style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms"
        class="lv-service lv-service--{{ block.settings.style }}"
        {{ block.shopify_attributes }}
      >
        <p class="lv-service__icon">{{ block.settings.icon }}</p>
        <h3 class="lv-head lv-service__title">{{ block.settings.title }}</h3>
        <p class="lv-service__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "LV Service Cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Service counter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Repairs that keep tools working" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon letter", "default": "S" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Description" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary (filled)" },
            { "value": "surface", "label": "Surface (card)" }
          ],
          "default": "surface"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "LV Service Cards",
      "blocks": [
        { "type": "service", "settings": { "icon": "S", "title": "Shear Sharpening", "text": "Precision sharpening from the Ed Vogel Company side of LaVille.", "style": "primary" } },
        { "type": "service", "settings": { "icon": "B", "title": "Blade Grinding", "text": "Grinding for barber and animal grooming blades of all types.", "style": "surface" } },
        { "type": "service", "settings": { "icon": "C", "title": "Clipper & Dryer Repairs", "text": "Keep daily-use tools out of the junk drawer and back on station.", "style": "surface" } },
        { "type": "service", "settings": { "icon": "P", "title": "Product Help", "text": "Straight answers when you need the right tool, blade, or replacement part.", "style": "surface" } }
      ]
    }
  ]
}
{% endschema %}
